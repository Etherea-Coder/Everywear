migrate_working_dir/
.tooling/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code
# FIX: Uncommented — launch configs and tasks should not be in version
# control for a team project. If you DO want to share debug configs,
# use a dedicated .vscode/launch.json that doesn't contain secrets.
.vscode/
*.code-workspace

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
**/build/
/web/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
android/app/.cxx

# ─── ANDROID SIGNING ──────────────────────────────────────
# FIX: Missing from original. Without these, your Play Store
# signing key could be accidentally committed.
key.properties
**/*.keystore
**/*.jks

# ─── SECRETS & ENVIRONMENT ─────────────────────────────────
# FIX: The original only had env.json and supabase/.env.local.
# Missing .env, .env.*, Firebase files, and service accounts.

# Environment variable files
.env
.env.*
!.env.example
env.json

# Supabase local config
supabase/.env.local
supabase/.env

# Firebase — contains project IDs and app IDs that should not be public
google-services.json
GoogleService-Info.plist
firebase_options.dart

# API keys & service accounts
**/secrets/
**/credentials/
service-account*.json

# RevenueCat / payment keys
**/revenuecat_keys.*

# ─── iOS / macOS GENERATED ─────────────────────────────────
# FIX: Missing from original. These are generated at build time.
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/xcuserdata
**/ios/Flutter/ephemeral/
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral/
**/linux/flutter/ephemeral/

# ─── COVERAGE & TESTING ────────────────────────────────────
coverage/

# ─── GENERATED CODE ────────────────────────────────────────
# FIX: Missing. These are auto-generated and should not be committed.
*.g.dart
*.freezed.dart

# ─── SUPABASE ──────────────────────────────────────────────
supabase/.temp/
supabase/functions/node_modules/
